APP_NAME="Camp Match API"
APP_ENV="local"
DEBUG=false
LOG_LEVEL="INFO"
DATABASE_URL=postgresql+asyncpg://jasper:what1234@localhost:5432/camp_match_dev
JWT_SECRET_KEY="a-very-long-and-random-string-for-development-only"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MEDIA_STORAGE_PATH="./var/media"
MEDIA_ACCESS_TOKEN_SECRET="media-secret-key-placeholder"
MEDIA_ACCESS_TOKEN_TTL_SECONDS=300
MESSAGING_MAX_MESSAGE_LENGTH=2000
MESSAGING_HISTORY_DEFAULT_LIMIT=30
MESSAGING_HISTORY_MAX_LIMIT=100
MESSAGING_SEND_RATE_LIMIT=30
MESSAGING_SEND_RATE_WINDOW_SECONDS=60
MESSAGING_CREATE_RATE_LIMIT=10
MESSAGING_CREATE_RATE_WINDOW_SECONDS=60
MESSAGING_WS_AUTH_TTL_SECONDS=900
MESSAGING_REALTIME_BACKEND="in_memory"
NOTIFICATION_INBOX_MAX_ATTEMPTS=8
NOTIFICATION_INBOX_BACKOFF_BASE_SECONDS=30
NOTIFICATION_INBOX_BACKOFF_CAP_SECONDS=3600
NOTIFICATION_WORKER_BATCH_SIZE=100
NOTIFICATION_DEBUG_FAIL_PROCESSING=false
SAFETY_REPORT_RATE_LIMIT_COUNT=5
SAFETY_REPORT_RATE_LIMIT_WINDOW_SECONDS=86400
SAFETY_REPORT_DESCRIPTION_MIN=10
SAFETY_REPORT_DESCRIPTION_MAX=2000
SAFETY_MAX_REPORTED_MESSAGES=5
SAFETY_NOTE_MAX_LENGTH=4000
SAFETY_RATIONALE_MIN=20
SAFETY_RATIONALE_MAX=4000
SAFETY_RESTRICTION_MAX_DAYS=90
SAFETY_ENFORCEMENT_MAX_ATTEMPTS=6
SAFETY_ENFORCEMENT_BACKOFF_BASE_SECONDS=60
SAFETY_ENFORCEMENT_BACKOFF_CAP_SECONDS=3600
SAFETY_WORKER_BATCH_SIZE=100
SAFETY_DEBUG_FAIL_ENFORCEMENT=false
ADMIN_OVERVIEW_SECTION_TIMEOUT_SECONDS=3.0
ADMIN_REASON_MIN_LENGTH=10
ADMIN_RESOLUTION_MIN_LENGTH=10
ADMIN_ISSUE_DESCRIPTION_MAX=2000
ADMIN_AUDIT_UNCERTAIN_AFTER_SECONDS=300
ADMIN_DEBUG_FAIL_SECTION=""
ADMIN_DEBUG_ACCOUNT_ACTION_MODE=""
